# Resource Tracker — live shared database (Stage B).
# Copy this file to .env.local (git-ignored) and fill in the two values from Supabase:
#   Project Settings → API Keys → "Publishable key"        (starts with sb_publishable_)
#   Project Settings → Data API  → "Project URL"            (https://<ref>.supabase.co)
# NEVER put the secret key (sb_secret_…) or the legacy service_role key here — the build refuses them.
RT_BACKEND=supabase
RT_SUPABASE_URL=https://your-project-ref.supabase.co
RT_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
